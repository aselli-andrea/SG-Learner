# devstack/settings - variabili del plugin DevStack di SG-Learner
#
# Caricato da DevStack prima di plugin.sh. Ogni variabile puo' essere
# sovrascritta nel local.conf.

# Abilita il servizio e l'API REST quando il plugin e' attivato con
# enable_plugin. La CLI sg-learner e' un client dell'API: senza
# sg-learner-api resta attivo solo il servizio.
enable_service sg-learner sg-learner-api

# Percorsi
SG_LEARNER_DIR=${SG_LEARNER_DIR:-$DEST/sg-learner}
SG_LEARNER_CONF_DIR=${SG_LEARNER_CONF_DIR:-/etc/sg-learner}
SG_LEARNER_CONF=${SG_LEARNER_CONF:-$SG_LEARNER_CONF_DIR/sg-learner.conf}
SG_LEARNER_DATA_DIR=${SG_LEARNER_DATA_DIR:-$DATA_DIR/sg-learner}

# Utente di servizio in Keystone (progetto "service")
SG_LEARNER_SERVICE_USER=${SG_LEARNER_SERVICE_USER:-sg-learner}

# API REST: indirizzo e porta di ascolto, URL registrato nel catalogo
SG_LEARNER_API_HOST=${SG_LEARNER_API_HOST:-0.0.0.0}
SG_LEARNER_API_PORT=${SG_LEARNER_API_PORT:-9797}
SG_LEARNER_API_URL=${SG_LEARNER_API_URL:-http://$SERVICE_HOST:$SG_LEARNER_API_PORT/v1}

# Ciclo di controllo del servizio, in secondi
SG_LEARNER_INTERVAL=${SG_LEARNER_INTERVAL:-30}

# Log delle ACL scritto da ovn-controller
SG_LEARNER_OVN_LOG=${SG_LEARNER_OVN_LOG:-/var/log/ovn/ovn-controller.log}

# Packet Logging di Neutron
SG_LEARNER_ML2_CONF=${SG_LEARNER_ML2_CONF:-/etc/neutron/plugins/ml2/ml2_conf.ini}
# rate_limit: pacchetti registrati al secondo; burst_limit: quanti in piu' in
# un picco. OVN registra ogni pacchetto della connessione, non solo il SYN:
# con i minimi della documentazione (100 e 25) piu' SSH ravvicinate superano
# il limite e il SYN di una puo' andare perso, cosi' la connessione non viene
# contata. Valori piu' alti costano piu' CPU a ovn-controller
SG_LEARNER_LOG_RATE_LIMIT=${SG_LEARNER_LOG_RATE_LIMIT:-500}
SG_LEARNER_LOG_BURST_LIMIT=${SG_LEARNER_LOG_BURST_LIMIT:-250}
